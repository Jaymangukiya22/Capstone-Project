{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(node --check:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose build:*)",
      "Bash(docker ps:*)",
      "Bash(docker stats --no-stream:*)",
      "Bash(docker inspect:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s -o /dev/null -w:*)"
    ],
    "deny": []
  }
}
